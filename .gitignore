# ==========================================
# 1. 敏感凭证与环境变量 (绝对不能上传到 GitHub)
# ==========================================
.env
.env.local
.env.*.local
deploy/.env
*.env
*.pem
*.key
*.cert
# 保留环境变量示例模板供开源参考
!.env.example
!deploy/.env.example

# ==========================================
# 2. 真实物理数据与数据库 (保护自用隐私文件)
# ==========================================
data/
uploads/
/storage/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ==========================================
# 3. 依赖包目录 (体量过大且应由机器本地安装)
# ==========================================
node_modules/
web/node_modules/
.pnpm-store/

# ==========================================
# 4. 编译输出二进制与测试产物
# ==========================================
my-silo
my-silo-linux
my-silo-windows.exe
my-silo-darwin
deploy/bin/
*.exe
*.out
*.test

# ==========================================
# 5. 操作系统缓存与编辑器配置
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/
*.sublime-workspace

# AI 规则适配产物：只维护 ai/rules/ 中的规则源
/.agents/rules/
/AGENTS.md
*.sublime-project

# ==========================================
# 6. 日志与临时通信 Socket
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.sock

# ==========================================
# 7. 前端编译产物 (不污染 Git 历史)
# ==========================================
dist/
web/dist/
