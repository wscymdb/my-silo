# ===================================================
# my-silo 私有资源管理服务 生产部署环境变量配置
# ===================================================

# 1. 容器与服务端口配置
APP_NAME=my-silo
APP_PORT=8989                 # 宿主机对外映射访问端口 (默认: 8989)
IMAGE_TAG=latest

# 2. Silo 管理员与存储配置
SILO_ADMIN_USER=admin         # 管理员用户名
SILO_ADMIN_PASSWORD=change_this_to_your_secure_password # 管理员密码
SILO_API_KEY=                 # 可选: 自动化脚本/图床客户端的固定 Token
SILO_MAX_SIZE_MB=500          # 单文件上传限制 (MB)

# 3. 远程云服务器部署配置 (一键发布到此服务器)
SERVER_HOST=                  # 目标服务器 IP 或域名 (例如: 123.45.67.89)
SERVER_USER=root              # SSH 登录用户名 (默认: root)
SERVER_SSH_PORT=22            # SSH 登录端口 (默认: 22)
SERVER_DIR=/opt/my-silo       # 服务器部署路径；支持 ~/my-silo，~ 指 SERVER_USER 的服务器 home
