{
  "name": "my-silo",
  "private": true,
  "scripts": {
    "dev:go": "go run ./cmd/server",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently -n \"go,web\" -c \"blue.bold,green.bold\" \"npm run dev:go\" \"npm run dev:web\"",
    "build:web": "npm --prefix web run build",
    "build": "npm --prefix web run build && go build -o my-silo ./cmd/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
